{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "spacelive-realtime",
  "account_id": "4465bbcc09f7b9f879ca63f37780539d",
  "main": "worker.js",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": false,
  "vars": {"PUBLIC_ORIGIN": "https://spacelive.vercel.app", "COORDINATOR_NAME": "spacelive-v3"},
  "durable_objects": {"bindings": [{"name": "COORDINATOR", "class_name": "SpaceliveCoordinator"}, {"name":"DEBUGGER","class_name":"SpaceliveDebug"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["SpaceliveCoordinator"]},{"tag":"v2-debug","new_sqlite_classes":["SpaceliveDebug"]}],
  "observability": {"enabled": true, "head_sampling_rate": 0.1}
}
