TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=
COLLECTOR_SECRET=

# Keep OPERATIONS_SECRET stable: it also encrypts existing integrations.
OPERATIONS_SECRET=
ADMIN_SESSION_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# OAuth callback: https://spacelive.vercel.app/api/auth/github/callback

# Set only after the personal-account Cloudflare collector passes validation.
# Empty keeps the existing Vercel collector during staged rollout/rollback.
SPACELIVE_REALTIME_ORIGIN=
